DEMO_MODE=false
TRANSLATION_ENABLED=true
STT_ENABLED=true
TTS_ENABLED=true
LLM_ENABLED=false
CPU_ONLY=false
KEEP_MODELS_LOADED=true
MODEL_DIR=./models
STORAGE_DIR=./data/storage
DATABASE_URL=sqlite:///./data/bhashasaathi.db
PARLER_DESCRIPTION_TOKENIZER=./tts/flan-t5-large
LIVE_QUEUE_SIZE=2
LIVE_TRANSLATION_BEAMS=2
TEXT_TRANSLATION_BEAMS=3
MAX_LIVE_SEGMENT_MS=2200
LIVE_END_SILENCE_MS=280
LIVE_HISTORY_TTL_HOURS=24
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# CPU performance knobs
TORCH_THREADS=6
TRANSLATION_MAX_NEW_TOKENS=128
LIVE_TRANSLATION_MAX_NEW_TOKENS=96
TRANSLATION_ROUTE_CACHE_LIMIT=2
LIVE_TTS_STREAM_SECONDS=0.5
